# Copy to .env and fill in. Never commit the real file.

# Supabase → Project Settings → API
# URL is built from the project ref, NOT the dashboard address.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon / public key (newer dashboards call this the publishable key).
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key (newer dashboards: secret key). Server only.
# Optional: without it the app uses the anon key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Password for /admin. Required, or the admin page stays locked.
ADMIN_PASSWORD=

# Optional: comma-separated names. Falls back to src/data/roster.seed.json.
# LUNCH_MATE_ROSTER=강민혁,김서준,김지우

# Optional local-development overrides.
# LUNCH_MATE_FORCE_FILE_STORE=1
# LUNCH_MATE_DATA_FILE=./data/lunch-mate.json
